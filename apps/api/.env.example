LASTRO_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lastro?sslmode=disable
LOG_LEVEL=debug
LOG_FORMAT=text
SHUTDOWN_TIMEOUT=15s
